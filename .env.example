# textcast configuration. Every value here has a working default —
# copy this to .env and change only what you care about.

# --- text to speech -------------------------------------------------------
# Kokoro is the engine. `textcast voices` lists what it can sound like.
TEXTCAST_TTS_ENGINE=kokoro
TEXTCAST_TTS_VOICE=af_heart

# A second voice for block quotes reads better than saying "start quote".
# Leave blank to keep the spoken cues instead.
# TEXTCAST_TTS_QUOTE_VOICE=bm_george

# How fast the voice reads, baked into the audio. 1.0 is the model's own pace.
# The player has its own speed control, which changes nothing on disk.
# TEXTCAST_TTS_SPEED=1.0

# How many engine instances render blocks side by side. Unset means one per
# core, capped at 4. Measured here: four single-threaded instances beat one
# four-threaded instance by ~11%; six are worse than four.
# TEXTCAST_CONCURRENCY=4

# Threads per instance. The pool sets this to 1 itself when it runs more
# than one instance, so you rarely need it.
# TEXTCAST_TTS_THREADS=1

# --- audio ----------------------------------------------------------------
TEXTCAST_AUDIO_BITRATE=32k

# --- section summaries (optional) -----------------------------------------
# Any endpoint that speaks the OpenAI protocol. These are only the defaults;
# the Summaries page stores its own values, which win over anything here.
# TEXTCAST_SUMMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# TEXTCAST_SUMMARY_MODEL=gemini-2.5-flash
# TEXTCAST_SUMMARY_API_KEY=
# GEMINI_API_KEY=

# --- storage --------------------------------------------------------------
# Database, audio, model cache and saved sources all live here.
TEXTCAST_DATA_DIR=./data

# --- access ---------------------------------------------------------------
# Off by default, which suits a private network (a VPN, a tailnet, or your
# own LAN). Turn it on for anything reachable from the internet, and set a
# token: /login takes it and keeps it in a cookie.
TEXTCAST_REQUIRE_AUTH=0
# TEXTCAST_AUTH_TOKEN=a-long-random-string

# Where the app listens. 127.0.0.1 keeps it on this machine only.
TEXTCAST_HOST=0.0.0.0
TEXTCAST_PORT=8000

# --- newsletters over IMAP (optional) -------------------------------------
# Point this at a dedicated address or a filtered folder.
# TEXTCAST_IMAP_HOST=imap.fastmail.com
# TEXTCAST_IMAP_USER=you@example.com
# TEXTCAST_IMAP_PASSWORD=an-app-password
# TEXTCAST_IMAP_FOLDER=INBOX
# TEXTCAST_IMAP_DAYS=14
