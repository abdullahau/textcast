# Copy to .env and change what you need. Everything has a working default.
# Compose reads this file twice: to fill in ${...} in docker-compose.yml, and
# as the container's environment.

# --- docker ---------------------------------------------------------------
# Must match the owner of ./data, or writes fail. Use `id -u` and `id -g`.
TEXTCAST_UID=1000
TEXTCAST_GID=1000
# Leave a core for the web process.
TEXTCAST_WORKER_CPUS=3

# --- text to speech -------------------------------------------------------
# kokoro-onnx or kokoro. Both offer the same voices; the article page can
# override this per article.
TEXTCAST_TTS_ENGINE=kokoro-onnx
TEXTCAST_TTS_VOICE=af_heart

# A second voice for block quotes. Blank keeps the spoken "start quote" cues.
# TEXTCAST_TTS_QUOTE_VOICE=bm_george

# Reading pace, baked into the audio. The player's speed control is separate.
# TEXTCAST_TTS_SPEED=1.0

# Engine instances rendering side by side. Unset means one per core, max 4.
# TEXTCAST_CONCURRENCY=4

# Threads per instance. Set to 1 automatically when there is more than one.
# TEXTCAST_TTS_THREADS=1

# There is no GPU setting. The device is chosen when the image is built:
#   docker compose up -d --build                                    # CPU
#   docker compose -f docker-compose.yml -f docker-compose.gpu.yml \
#                  up -d --build                                    # NVIDIA

# --- audio ----------------------------------------------------------------
TEXTCAST_AUDIO_BITRATE=32k
# Pause after a block, and after a heading.
# TEXTCAST_AUDIO_GAP_MS=350
# TEXTCAST_AUDIO_HEADING_GAP_MS=700

# --- the build worker -----------------------------------------------------
# 1 runs the worker inside the web process. docker-compose.yml sets 0,
# because the worker is its own container there.
# TEXTCAST_WORKERS=1

# --- section summaries (optional) -----------------------------------------
# Any OpenAI-compatible endpoint. The Summaries page lists the providers and
# fills in the address, and what you save there wins over these.
# The page stores one key per endpoint; this is the fallback for any endpoint
# with none stored.
# TEXTCAST_SUMMARY_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# TEXTCAST_SUMMARY_MODEL=gemini-2.5-flash
# TEXTCAST_SUMMARY_API_KEY=

# --- hugging face (optional) ----------------------------------------------
# A read-only token, used only while the image is built. It raises the hub's
# anonymous rate limit; the Kokoro repo is public, so builds work without it.
# Passed as a build secret, so it is never written into the image.
# HF_TOKEN=hf_...

# --- storage --------------------------------------------------------------
# Database, audio, block cache and saved sources. Mounted at /data.
TEXTCAST_DATA_DIR=./data

# --- access ---------------------------------------------------------------
# Turn on for anything reachable from the internet. /login takes the token
# and keeps it in a cookie.
TEXTCAST_REQUIRE_AUTH=0
# TEXTCAST_AUTH_TOKEN=a-long-random-string

# 127.0.0.1 keeps the app on this machine only.
TEXTCAST_HOST=0.0.0.0
TEXTCAST_PORT=8000

# --- newsletters by mailbox (optional) ------------------------------------
# A dedicated address, or a filtered folder.
# TEXTCAST_IMAP_HOST=imap.fastmail.com
# TEXTCAST_IMAP_PORT=993
# TEXTCAST_IMAP_USER=you@example.com
# TEXTCAST_IMAP_PASSWORD=an-app-password
# TEXTCAST_IMAP_FOLDER=INBOX
# TEXTCAST_IMAP_DAYS=14
# TEXTCAST_IMAP_MARK_SEEN=1
# Minutes between polls. 0 disables the poller.
# TEXTCAST_MAIL_POLL_MINUTES=0
