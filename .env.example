# --- text to speech -------------------------------------------------------
# supertonic (default, ONNX only) or kokoro (needs the kokoro extra + espeak-ng)
TEXTCAST_TTS_ENGINE=supertonic
TEXTCAST_TTS_VOICE=M1
# A second voice for block quotes reads better than saying "start quote".
TEXTCAST_TTS_QUOTE_VOICE=F3
# 2 is fastest, 8 is the SDK default, 4 is the best trade on a small CPU.
TEXTCAST_TTS_STEPS=4
# Leave unset to use every core; set it lower to keep the box responsive.
# TEXTCAST_TTS_THREADS=3

# --- audio ----------------------------------------------------------------
TEXTCAST_AUDIO_BITRATE=32k

# --- newsletters over IMAP (optional) -------------------------------------
# Point this at a dedicated address or a filtered folder.
# TEXTCAST_IMAP_HOST=imap.fastmail.com
# TEXTCAST_IMAP_USER=you@example.com
# TEXTCAST_IMAP_PASSWORD=an-app-password
# TEXTCAST_IMAP_FOLDER=INBOX
# TEXTCAST_IMAP_DAYS=14

# --- optional AI summaries ------------------------------------------------
# GEMINI_API_KEY=

# --- auth -----------------------------------------------------------------
# Off by default: the app is reachable only on your tailnet.
# TEXTCAST_REQUIRE_AUTH=1
# TEXTCAST_AUTH_TOKEN=

# --- tailscale ------------------------------------------------------------
# From https://login.tailscale.com/admin/settings/keys (reusable, ephemeral off)
TS_AUTHKEY=
