      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "Traps worth knowing",
      "originalText": "Traps worth knowing",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 16
    },
    {
      "angle": 0,
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g0285"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 860157272,
      "version": 1,
      "versionNonce": 778545236,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "id": "t0288",
      "type": "text",
      "x": 2834,
      "y": 490,
      "width": 452,
      "height": 195.0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "\u00b7 The service worker caches /static/\n  hard. A CSS edit can be live on disk\n  and invisible in the browser.\n\u00b7 seeked means the playhead moved, not\n  that anything is decoded there.\n  Wait for readyState >= 3.\n\u00b7 A section's place in the payload is\n  not its idx: sections with no audio\n  are dropped from the array.\n\u00b7 The cache key must carry every knob\n  that changes the audio.\n\u00b7 Nothing may load a model in a request.",
      "originalText": "\u00b7 The service worker caches /static/\n  hard. A CSS edit can be live on disk\n  and invisible in the browser.\n\u00b7 seeked means the playhead moved, not\n  that anything is decoded there.\n  Wait for readyState >= 3.\n\u00b7 A section's place in the payload is\n  not its idx: sections with no audio\n  are dropped from the array.\n\u00b7 The cache key must carry every knob\n  that changes the audio.\n\u00b7 Nothing may load a model in a request.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 13
    },
    {
      "angle": 0,
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g0289"
