      "id": "t0283",
      "type": "text",
      "x": 2834,
      "y": 81,
      "width": 452,
      "height": 20.0,
      "strokeColor": "#846358",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "Deployment: two processes, one image",
      "originalText": "Deployment: two processes, one image",
      "fontSize": 16,
      "fontFamily": 1,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 16
    },
    {
      "angle": 0,
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g0281"
      ],
      "frameId": null,
      "roundness": null,
      "seed": 1522867401,
      "version": 1,
      "versionNonce": 1847184916,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "id": "t0284",
      "type": "text",
      "x": 2834,
      "y": 110,
      "width": 452,
      "height": 227.5,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "docker compose up -d --build\n\n  web     uvicorn, serves the app\n  worker  python -m textcast, builds\n          the audio and polls the mail\n\nBoth mount ./data and run as\nTEXTCAST_UID:TEXTCAST_GID from .env \u2014\nthe image's uid is 10001 and the host's\nis not, which shows up as\n\"attempt to write a readonly database\".\n\nThere is no command line. The app is\nthe interface; a second one drifts.",
      "originalText": "docker compose up -d --build\n\n  web     uvicorn, serves the app\n  worker  python -m textcast, builds\n          the audio and polls the mail\n\nBoth mount ./data and run as\nTEXTCAST_UID:TEXTCAST_GID from .env \u2014\nthe image's uid is 10001 and the host's\nis not, which shows up as\n\"attempt to write a readonly database\".\n\nThere is no command line. The app is\nthe interface; a second one drifts.",
      "fontSize": 13,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "baseline": 13
    },
    {
      "angle": 0,
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [
        "g0285"
      ],
      "frameId": null,
      "roundness": {
        "type": 3
      },
      "seed": 902308771,
      "version": 1,
      "versionNonce": 1602683975,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "id": "r0286",
      "type": "rectangle",
      "x": 2820,
      "y": 450,
      "width": 480,
      "height": 310,
      "strokeColor": "#846358",
      "backgroundColor": "#ffffff",
