      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "text": "textcast.db   the library \u2014 text only\nmedia/        the audio and cue tracks\nsources/      the originals, so a parser\n              fix can be replayed\ncache/        raw renders, so a rebuild\n              is an encode, not a re-read",
      "originalText": "textcast.db   the library \u2014 text only\nmedia/        the audio and cue tracks\nsources/      the originals, so a parser\n              fix can be replayed\ncache/        raw renders, so a rebuild\n              is an encode, not a re-read",
      "fontSize": 15,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
